# Copy to .env and fill in. NEVER commit .env.
# Generate a strong, URL-safe password (needed: >= 16 chars in production):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=engiverse
POSTGRES_DB=engiverse

# Optional
# LOG_LEVEL=INFO
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8080
# CORS_ORIGINS=            # comma-separated bare origins; empty in prod (same-origin via nginx)
# DB_HOST_PORT=5432        # dev override only
